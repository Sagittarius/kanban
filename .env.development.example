# Copy to .env.development.local for local development.

# Enable auth/login flow in dev:
KANBAN_AUTH_ENABLED=true

# Local development database driver.
KANBAN_DB_DRIVER=postgres

# PostgreSQL connection string for migrated local development.
POSTGRES_URL=postgres://kanban:change-this-password@localhost:5432/kanban
KANBAN_PG_POOL_MAX=10
KANBAN_PG_IDLE_TIMEOUT_MS=30000
KANBAN_PG_CONNECTION_TIMEOUT_MS=5000

# SQLite fallback path. Use pnpm run local:dev:sqlite when developing against SQLite.
KANBAN_SQLITE_PATH=.data/kanban.sqlite

# SQLite backup directory used by safe upgrade scripts
KANBAN_SQLITE_BACKUP_DIR=.data/backups

# Whether docker-like startup should auto-run safe upgrade
KANBAN_AUTO_UPGRADE=false

# Maintenance state file used by preflight/upgrade flow
KANBAN_MAINTENANCE_STATE_PATH=.data/kanban-maintenance.json

# Maintenance page token for manual upgrade in local dev
KANBAN_MAINTENANCE_TOKEN=change-this-maintenance-token

# App metadata shown in maintenance/footer. {version} comes from package.json version.
KANBAN_IMAGE_TAG=kanban:dev-{version}

# Structured JSON logs. Set KANBAN_LOG_FILE or KANBAN_LOG_DIR to persist logs to disk.
KANBAN_LOG_LEVEL=debug
KANBAN_LOG_CONSOLE=true
# KANBAN_LOG_DIR=.data/logs
# KANBAN_LOG_FILE=.data/logs/kanban.log

# Bootstrap admin account for auth-enabled local dev
KANBAN_SUPER_ADMIN_USERNAME=admin
KANBAN_SUPER_ADMIN_PASSWORD=admin@123
KANBAN_DEFAULT_TIMEZONE=Asia/Shanghai

# Session signing secret used when auth is enabled
KANBAN_AUTH_SECRET=change-this-secret-in-local-dev
# Login session lifetime in hours. Defaults to 24.
KANBAN_SESSION_TIMEOUT=24h
