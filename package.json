{
  "name": "project-kanban-board",
  "version": "1.4.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:auth": "KANBAN_AUTH_ENABLED=true vinext dev",
    "dev:noauth": "KANBAN_AUTH_ENABLED=false vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .remember",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local-sqlite.mjs",
    "db:migrate:sqlite-to-postgres:check": "node scripts/migrate-sqlite-to-postgres.mjs --check",
    "db:migrate:sqlite-to-postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "db:maintenance:preflight": "node scripts/preflight-maintenance.mjs",
    "db:upgrade:check": "node scripts/upgrade-local-sqlite.mjs --check",
    "db:upgrade:safe": "node scripts/upgrade-local-sqlite.mjs",
    "db:restore:sqlite": "node scripts/restore-local-sqlite-backup.mjs",
    "seed:feature-demo": "node scripts/seed-feature-demo.mjs",
    "local:dev": "pnpm run db:migrate:local && vinext dev --hostname 0.0.0.0",
    "local:start": "pnpm run db:migrate:local && vinext start --hostname 0.0.0.0"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
