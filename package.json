{
  "name": "project-kanban-board",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:auth": "KANBAN_AUTH_ENABLED=true vinext dev",
    "dev:noauth": "KANBAN_AUTH_ENABLED=false vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .remember",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local-sqlite.mjs",
    "db:migrate:sqlite-to-postgres:check": "node scripts/migrate-sqlite-to-postgres.mjs --check",
    "db:migrate:sqlite-to-postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "db:maintenance:preflight": "node scripts/preflight-maintenance.mjs",
    "db:upgrade:check": "node scripts/upgrade-local-sqlite.mjs --check",
    "db:upgrade:safe": "node scripts/upgrade-local-sqlite.mjs",
    "db:restore:sqlite": "node scripts/restore-local-sqlite-backup.mjs",
    "seed:feature-demo": "node scripts/seed-feature-demo.mjs",
    "local:dev": "pnpm run db:migrate:local && vinext dev --hostname 0.0.0.0",
    "local:start": "pnpm run db:migrate:local && vinext start --hostname 0.0.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.4.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-legacy": "^8.1.0",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "terser": "^5.48.0",
    "typescript": "5.9.3"
  },
  "browserslist": {
    "production": [
      "Chrome >= 87",
      "Edge >= 87",
      "Firefox >= 78",
      "Safari >= 14"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Edge version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  },
  "type": "module"
}
