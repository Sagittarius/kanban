{
  "name": "project-kanban-board",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:auth": "KANBAN_AUTH_ENABLED=true next dev",
    "dev:noauth": "KANBAN_AUTH_ENABLED=false next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node server.js",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .remember",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local-sqlite.mjs",
    "db:migrate:sqlite-to-postgres:check": "node scripts/migrate-sqlite-to-postgres.mjs --check",
    "db:migrate:sqlite-to-postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "db:maintenance:preflight": "node scripts/preflight-maintenance.mjs",
    "db:upgrade:check": "node scripts/upgrade-local-sqlite.mjs --check",
    "db:upgrade:safe": "node scripts/upgrade-local-sqlite.mjs",
    "db:restore:sqlite": "node scripts/restore-local-sqlite-backup.mjs",
    "seed:feature-demo": "node scripts/seed-feature-demo.mjs",
    "local:dev": "pnpm run db:migrate:local && next dev --hostname 0.0.0.0",
    "local:start": "pnpm run db:migrate:local && next start -H 0.0.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "core-js-bundle": "^3.47.0",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.4.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "terser": "^5.48.0",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "Chrome >= 87",
    "Edge >= 87",
    "Firefox >= 90",
    "Safari >= 15",
    "not IE 11"
  ],
  "type": "module"
}
